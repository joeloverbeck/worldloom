{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-diegetic-artifact.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "title", "author", "genre", "body", "intended_audience", "circulation", "truth_relation"],
  "properties": {
    "id": { "type": "string", "pattern": "^DA-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^DA-(0|[1-9][0-9]*)$" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "pattern": "^(STENT-(0|[1-9][0-9]*)|group:[A-Za-z0-9 _:-]+|unknown|anonymous)$" },
    "genre": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "intended_audience": { "type": "string", "pattern": "^(STENT-(0|[1-9][0-9]*)|group:[A-Za-z0-9 _:-]+|public|self|none)$" },
    "circulation": { "type": "string", "enum": ["private", "factional", "public", "concealed", "suppressed"] },
    "truth_relation": { "type": "string", "enum": ["true", "false", "partly_true", "unknown", "contested", "branch_counterfactual", "future_contingent"] },
    "derived_from": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(CF|STENT|STINT|SF|BEL|SE|OBL|CNSQ|THR|SREL|STLOC|STOBJ|DA|BR|PG|CHC|SLT)-(0|[1-9][0-9]*)$" }
    }
  },
  "additionalProperties": false
}
