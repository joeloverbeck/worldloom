{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-arc-trace.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "created_at_page",
    "arc_realized",
    "effect_variant_applied",
    "realized_beats",
    "observed_actions",
    "observed_claims",
    "possible_violations",
    "stop_condition_hit",
    "effect_evidence",
    "semantic_critic_verdict"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ARCTRACE-[0-9]{4}$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]{3,4}$" },
    "created_at_page": { "type": "string", "pattern": "^PG-[0-9]{4}$" },
    "arc_realized": { "type": "string", "pattern": "^SLT-[0-9]{4}$" },
    "effect_variant_applied": { "type": "string", "minLength": 1 },
    "realized_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "function", "evidence_span", "realized"],
        "properties": {
          "beat_id": { "type": "string", "minLength": 1 },
          "function": { "type": "string", "minLength": 1 },
          "evidence_span": { "$ref": "#/$defs/evidenceSpan" },
          "realized": { "type": "string", "enum": ["true", "partially", "not"] }
        },
        "additionalProperties": true
      }
    },
    "observed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target", "evidence_span"],
        "properties": {
          "actor": { "type": "string", "pattern": "^STENT-[0-9]{4}$" },
          "action": { "type": "string", "minLength": 1 },
          "target": { "type": ["string", "null"] },
          "evidence_span": { "$ref": "#/$defs/evidenceSpan" }
        },
        "additionalProperties": true
      }
    },
    "observed_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "canon_status", "evidence_span"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["narrator", "character", "inference"] },
          "canon_status": { "type": "string", "enum": ["story_local", "apparent", "forbidden_risk"] },
          "evidence_span": { "$ref": "#/$defs/evidenceSpan" }
        },
        "additionalProperties": true
      }
    },
    "possible_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["envelope_item", "severity", "evidence_span"],
        "properties": {
          "envelope_item": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "evidence_span": { "$ref": "#/$defs/evidenceSpan" }
        },
        "additionalProperties": true
      }
    },
    "stop_condition_hit": {
      "type": "object",
      "required": ["id", "category", "evidence_span"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["normal_exit", "interrupt_before", "safety_valve"] },
        "evidence_span": { "$ref": "#/$defs/evidenceSpan" }
      },
      "additionalProperties": true
    },
    "effect_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effect_ref", "realized", "evidence_span"],
        "properties": {
          "effect_ref": { "type": "integer", "minimum": 0 },
          "realized": { "type": "string", "enum": ["true", "partially", "not"] },
          "evidence_span": { "$ref": "#/$defs/evidenceSpan" }
        },
        "additionalProperties": true
      }
    },
    "semantic_critic_verdict": {
      "type": "object",
      "required": ["status", "reasons", "required_revision_constraints"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "revise_prose", "reject_arc", "promote_interrupt"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "required_revision_constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "evidenceSpan": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
