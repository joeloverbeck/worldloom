{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-secret.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "created_at_page",
    "secret_kind",
    "secret_claim",
    "holders",
    "salience",
    "source_records",
    "status"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "story_secret_record" },
    "id": { "type": "string", "pattern": "^STSEC-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^STSEC-(0|[1-9][0-9]*)$" },
    "secret_kind": {
      "type": "string",
      "enum": ["identity", "motive", "location", "event_cause", "artifact_truth", "relationship", "institutional"]
    },
    "secret_claim": { "type": "string", "minLength": 1 },
    "truth_anchor": {
      "type": ["string", "null"],
      "pattern": "^(SF|BEL|DA)-(0|[1-9][0-9]*)$"
    },
    "holders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(STENT-(0|[1-9][0-9]*)|group:[A-Za-z0-9_-]+|narrator)$"
      }
    },
    "salience": { "type": "string", "enum": ["low", "medium", "high"] },
    "protected_mystery_refs": {
      "type": "array",
      "default": [],
      "items": { "type": "string", "pattern": "^M-(0|[1-9][0-9]*)$" }
    },
    "clue_carriers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "kind",
          "record",
          "clue_text",
          "clue_strength",
          "discovered_by",
          "audience_visible",
          "status"
        ],
        "properties": {
          "kind": { "type": "string", "enum": ["DA", "STOBJ", "STLOC", "BEL", "SF", "SE"] },
          "record": { "type": "string", "pattern": "^(DA|STOBJ|STLOC|BEL|SF|SE)-(0|[1-9][0-9]*)$" },
          "clue_text": { "type": "string", "minLength": 1 },
          "clue_strength": {
            "type": "string",
            "enum": ["weak", "suggestive", "confirming", "decisive", "misleading"]
          },
          "discovered_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(STENT-(0|[1-9][0-9]*)|group:[A-Za-z0-9_-]+|public)$"
            }
          },
          "audience_visible": { "type": "string", "enum": ["hidden", "visible", "ambiguous"] },
          "status": {
            "type": "string",
            "enum": ["available", "discovered", "destroyed", "suppressed", "superseded"]
          }
        },
        "additionalProperties": false
      }
    },
    "source_records": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" }
    },
    "status": {
      "type": "string",
      "enum": ["hidden", "partially_revealed", "revealed", "disproven", "abandoned"]
    },
    "reveal_event": { "type": ["string", "null"], "pattern": "^SE-(0|[1-9][0-9]*)$" },
    "reveal_records": {
      "type": "array",
      "default": [],
      "items": { "type": "string", "pattern": "^(BEL|SF|DA|STQ)-(0|[1-9][0-9]*)$" }
    }
  },
  "additionalProperties": false
}
