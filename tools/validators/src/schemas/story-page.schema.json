{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-page.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "branch_id",
    "parent_page_id",
    "branch_path",
    "turn_index",
    "input",
    "state_hash_parent",
    "state_hash",
    "state_snapshot",
    "plan",
    "prose_plan_path",
    "emitted_choices",
    "validation_trace"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "branch_id": { "type": "string", "pattern": "^BR-(0|[1-9][0-9]*)$" },
    "parent_page_id": { "type": ["string", "null"], "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "branch_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" }
    },
    "turn_index": { "type": "integer", "minimum": 0 },
    "input": {
      "type": "object",
      "description": "Exactly-one legality is enforced by state_snapshot_integrity conditional on the resolved event kind, with a carve-out for event_kind: story_start.",
      "required": ["choice_id", "manual_action_text", "resolved_event_id"],
      "properties": {
        "choice_id": { "type": ["string", "null"], "pattern": "^CHC-(0|[1-9][0-9]*)$" },
        "manual_action_text": { "type": ["string", "null"], "minLength": 1 },
        "resolved_event_id": { "type": "string", "pattern": "^SE-(0|[1-9][0-9]*)$" }
      },
      "additionalProperties": false
    },
    "state_hash_parent": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "state_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_snapshot": {
      "type": "object",
      "properties": {
        "canon_revision": { "type": ["string", "null"], "pattern": "^CH-[0-9]+$" },
        "active_records": {
          "type": "object",
          "properties": {
            "STENT": { "type": "array", "items": { "type": "string", "pattern": "^STENT-[0-9]+$" } },
            "STINT": { "type": "array", "items": { "type": "string", "pattern": "^STINT-[0-9]+$" } },
            "SF": { "type": "array", "items": { "type": "string", "pattern": "^SF-[0-9]+$" } },
            "BEL": { "type": "array", "items": { "type": "string", "pattern": "^BEL-[0-9]+$" } },
            "OBL": { "type": "array", "items": { "type": "string", "pattern": "^OBL-[0-9]+$" } },
            "CNSQ": { "type": "array", "items": { "type": "string", "pattern": "^CNSQ-[0-9]+$" } },
            "THR": { "type": "array", "items": { "type": "string", "pattern": "^THR-[0-9]+$" } },
            "SREL": { "type": "array", "items": { "type": "string", "pattern": "^SREL-[0-9]+$" } },
            "STLOC": { "type": "array", "items": { "type": "string", "pattern": "^STLOC-[0-9]+$" } },
            "STOBJ": { "type": "array", "items": { "type": "string", "pattern": "^STOBJ-[0-9]+$" } },
            "DA": { "type": "array", "items": { "type": "string", "pattern": "^DA-[0-9]+$" } },
            "STSTAT": { "type": "array", "items": { "type": "string", "pattern": "^STSTAT-[0-9]+$" } },
            "CLK": { "type": "array", "items": { "type": "string", "pattern": "^CLK-[0-9]+$" } },
            "STSEC": { "type": "array", "items": { "type": "string", "pattern": "^STSEC-[0-9]+$" } }
          },
          "additionalProperties": true
        },
        "entity_status": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["life", "agency", "location"],
            "properties": {
              "life": { "type": "string", "enum": ["alive", "dead", "unknown"] },
              "agency": { "type": "string", "enum": ["free", "constrained", "coerced", "captive", "incapacitated", "unconscious", "dead", "unknown"] },
              "location": {
                "oneOf": [
                  { "type": "string", "pattern": "^STLOC-[0-9]+$" },
                  { "type": "string", "enum": ["unknown", "concealed", "offstage"] }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "unresolved_mystery_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mystery_id", "authority", "status"],
            "properties": {
              "mystery_id": { "type": "string", "pattern": "^M-[0-9]+$" },
              "authority": { "type": "string", "enum": ["apparent", "branch_local_counterfactual", "canon_candidate"] },
              "status": { "type": "string", "enum": ["preserved", "clue_added", "narrowed", "apparent_resolution", "held_for_promotion"] },
              "evidence_records": {
                "type": "array",
                "default": [],
                "items": { "type": "string", "pattern": "^(SF|BEL|DA|SE)-[0-9]+$" }
              }
            },
            "additionalProperties": false
          }
        },
        "visible_affordances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ordinal", "label", "grounded_in", "available_to", "action_families"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0 },
              "label": { "type": "string", "minLength": 1 },
              "grounded_in": {
                "type": "array",
                "items": { "type": "string", "pattern": "^(STLOC|STOBJ)-[0-9]+$" }
              },
              "available_to": {
                "type": "array",
                "items": { "type": "string", "pattern": "^STENT-[0-9]+$" }
              },
              "action_families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "move",
                    "evade",
                    "pursue",
                    "perceive",
                    "investigate",
                    "communicate",
                    "persuade",
                    "negotiate",
                    "bond",
                    "oppose",
                    "harm",
                    "protect",
                    "control",
                    "transfer",
                    "use",
                    "make_change",
                    "ritual_protocol",
                    "recover",
                    "wait",
                    "decide"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "continuation": {
          "type": "object",
          "properties": {
            "has_eligible_commitment_block": { "type": "boolean" },
            "terminal_status": { "type": "string", "enum": ["open", "branch_pause", "terminal_closed"] },
            "terminal_rationale": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": ["plan_hash"],
      "properties": {
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Shared story state contract §4.2 sha256 hash of the committed prose plan."
        }
      },
      "additionalProperties": false
    },
    "prose_plan_path": {
      "type": "string",
      "pattern": "^pages-prose-plans/PG-(0|[1-9][0-9]*)\\.md$",
      "description": "Canonical top-level address of the page plan."
    },
    "emitted_choices": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CHC-(0|[1-9][0-9]*)$" }
    },
    "validation_trace": {
      "type": "object",
      "additionalProperties": true,
      "description": "One PASS-with-rationale entry per shared hard gate."
    }
  },
  "additionalProperties": false
}
