{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/mined-proposal-card.schema.json",
  "title": "MinedProposalCardFrontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "batch_id", "slug", "title", "source_artifact_id", "mining_context", "canon_fact_statement", "proposed_status", "type", "domains_touched", "recommended_scope", "why_not_universal", "narrator_reliability_basis", "scores", "score_aggregate", "immediate_consequences", "longer_term_consequences", "likely_required_downstream_updates", "risks", "canon_safety_check", "source_basis", "notes"],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "recordIdArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "canonFactType": {
      "type": "string",
      "enum": ["capability", "artifact", "law", "belief", "event", "institution", "species", "ritual", "taboo", "technology", "resource_distribution", "hidden_truth", "local_anomaly", "metaphysical_rule", "historical_process", "text_tradition", "hazard", "craft", "place", "polity", "route", "social_role", "ecological_system", "bloodline", "magic_practice", "divine_action", "artifact_dependent_truth", "exception_introducing_fact", "institution_with_secrecy", "knowledge_asymmetric_fact"]
    },
    "canonicalDomain": {
      "type": "string",
      "enum": ["labor", "embodiment", "social_norms", "architecture", "mobility", "law", "trade", "war", "kinship", "religion", "language", "status_signaling", "ecology", "daily_routine", "institutions", "everyday_life", "economy", "settlement_life", "memory_and_myth", "magic", "technology", "medicine", "status_order", "warfare", "geography", "taboo_and_pollution"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geographic", "temporal", "social"],
      "properties": {
        "geographic": { "type": "string", "enum": ["local", "regional", "global", "cosmic"] },
        "temporal": { "type": "string", "enum": ["ancient", "historical", "current", "future", "cyclical"] },
        "social": { "type": "string", "enum": ["restricted_group", "public", "elite", "secret", "rumor"] }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coherence", "propagation_value", "story_yield", "distinctiveness", "ordinary_life_relevance", "mystery_preservation", "integration_burden", "redundancy_risk"],
      "properties": {
        "coherence": { "type": "number" },
        "propagation_value": { "type": "number" },
        "story_yield": { "type": "number" },
        "distinctiveness": { "type": "number" },
        "ordinary_life_relevance": { "type": "number" },
        "mystery_preservation": { "type": "number" },
        "integration_burden": { "type": "number" },
        "redundancy_risk": { "type": "number" }
      }
    },
    "testResult": { "type": "string", "enum": ["pass", "partial", "fail"] },
    "mysteryReserveCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mr_id", "overlap", "note"],
      "properties": {
        "mr_id": { "type": "string", "pattern": "^M-[0-9]+$" },
        "overlap": { "type": "boolean" },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "canonSafetyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariants_respected", "invariants_violated", "mystery_reserve_firewall", "distribution_discipline", "diegetic_to_world_laundering", "repairs_applied"],
      "properties": {
        "invariants_respected": { "$ref": "#/$defs/recordIdArray" },
        "invariants_violated": { "$ref": "#/$defs/recordIdArray" },
        "mystery_reserve_firewall": { "type": "array", "items": { "$ref": "#/$defs/mysteryReserveCheck" } },
        "distribution_discipline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canon_facts_consulted", "why_not_universal_basis"],
          "properties": {
            "canon_facts_consulted": { "$ref": "#/$defs/recordIdArray" },
            "why_not_universal_basis": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "diegetic_to_world_laundering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_breadth", "epistemic_horizon", "mr_positional"],
          "properties": {
            "evidence_breadth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test_result", "independent_evidence", "rationale"],
              "properties": {
                "test_result": { "$ref": "#/$defs/testResult" },
                "independent_evidence": { "$ref": "#/$defs/recordIdArray" },
                "rationale": { "$ref": "#/$defs/nonEmptyString" }
              }
            },
            "epistemic_horizon": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test_result", "author_position_consulted", "rationale"],
              "properties": {
                "test_result": { "$ref": "#/$defs/testResult" },
                "author_position_consulted": { "$ref": "#/$defs/recordIdArray" },
                "rationale": { "$ref": "#/$defs/nonEmptyString" }
              }
            },
            "mr_positional": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test_result", "mr_ids_checked_positionally", "rationale"],
              "properties": {
                "test_result": { "$ref": "#/$defs/testResult" },
                "mr_ids_checked_positionally": { "type": "array", "items": { "type": "string", "pattern": "^M-[0-9]+$" } },
                "rationale": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "repairs_applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sub_check", "repair_type", "justification"],
            "properties": {
              "sub_check": { "$ref": "#/$defs/nonEmptyString" },
              "repair_type": { "$ref": "#/$defs/nonEmptyString" },
              "justification": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "sourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "required": ["direct_user_approval"],
        "properties": { "direct_user_approval": true }
      },
      "required": ["world_slug", "batch_id", "source_artifact_id", "derived_from_artifact_path", "generated_date", "user_approved", "derived_from_cfs"],
      "properties": {
        "world_slug": { "$ref": "#/$defs/nonEmptyString" },
        "batch_id": { "type": "string", "pattern": "^BATCH-[0-9]+$" },
        "source_artifact_id": { "type": "string", "pattern": "^DA-[0-9]+$" },
        "derived_from_artifact_path": { "$ref": "#/$defs/nonEmptyString" },
        "generated_date": { "$ref": "#/$defs/nonEmptyString" },
        "user_approved": { "type": "boolean" },
        "derived_from_cfs": { "$ref": "#/$defs/recordIdArray" }
      }
    }
  },
  "properties": {
    "proposal_id": { "type": "string", "pattern": "^PR-[0-9]+$" },
    "batch_id": { "type": "string", "pattern": "^BATCH-[0-9]+$" },
    "slug": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "source_artifact_id": { "type": "string", "pattern": "^DA-[0-9]+$" },
    "mining_context": { "$ref": "#/$defs/nonEmptyString" },
    "canon_fact_statement": { "$ref": "#/$defs/nonEmptyString" },
    "proposed_status": { "type": "string", "enum": ["hard_canon", "soft_canon", "contested_canon"] },
    "type": { "$ref": "#/$defs/canonFactType" },
    "domains_touched": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalDomain" } },
    "recommended_scope": { "$ref": "#/$defs/scope" },
    "why_not_universal": { "$ref": "#/$defs/stringArray" },
    "narrator_reliability_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "central_to_artifact", "cross_referenced_in_canon", "mapping_rationale"],
      "properties": {
        "stance": { "type": "string", "enum": ["firsthand", "secondhand", "propagandistic", "legendary", "outside_horizon", "firsthand-cumulative"] },
        "central_to_artifact": { "type": "boolean" },
        "cross_referenced_in_canon": { "type": "boolean" },
        "mapping_rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scores": { "$ref": "#/$defs/scores" },
    "score_aggregate": { "type": "number" },
    "immediate_consequences": { "$ref": "#/$defs/stringArray" },
    "longer_term_consequences": { "$ref": "#/$defs/stringArray" },
    "likely_required_downstream_updates": { "$ref": "#/$defs/stringArray" },
    "risks": { "$ref": "#/$defs/stringArray" },
    "canon_safety_check": { "$ref": "#/$defs/canonSafetyCheck" },
    "source_basis": { "$ref": "#/$defs/sourceBasis" },
    "notes": { "type": "string" }
  }
}
