{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/prose-receipt.schema.json",
  "type": "object",
  "required": [
    "page_id",
    "story_id",
    "plan_path",
    "prose_path",
    "plan_hash",
    "prose_hash",
    "state_hash_at_plan_time",
    "checked_at",
    "strict",
    "verdict",
    "checks",
    "notes",
    "repair_recommendation"
  ],
  "properties": {
    "page_id": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "plan_path": { "type": "string", "pattern": "^pages-prose-plans/PG-(0|[1-9][0-9]*)\\.md$" },
    "prose_path": { "type": "string", "pattern": "^pages-prose/PG-(0|[1-9][0-9]*)\\.md$" },
    "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prose_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_hash_at_plan_time": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "strict": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
    "checks": {
      "type": "object",
      "required": [
        "hash_integrity",
        "engine_jargon_leak",
        "forbidden_mystery_resolution",
        "required_event_rendered",
        "choice_consequence_visibility",
        "entity_status_consistency",
        "invented_structural_fact",
        "canon_claim_without_authority",
        "char_authority_leak",
        "craft_critic"
      ],
      "properties": {
        "hash_integrity": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "engine_jargon_leak": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "forbidden_mystery_resolution": { "type": "string", "enum": ["PASS", "FAIL"] },
        "required_event_rendered": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "choice_consequence_visibility": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "entity_status_consistency": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "invented_structural_fact": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "canon_claim_without_authority": { "type": "string", "enum": ["PASS", "FAIL"] },
        "char_authority_leak": { "type": "string", "enum": ["PASS", "FAIL"] },
        "craft_critic": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "NOT_RUN"] }
      },
      "additionalProperties": false
    },
    "stchar_authority": {
      "type": "array",
      "items": { "$ref": "#/$defs/stcharAuthorityCheck" }
    },
    "profile_fidelity": {
      "type": "array",
      "items": { "$ref": "#/$defs/profileFidelityCheck" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repair_recommendation": {
      "type": "string",
      "enum": [
        "none",
        "revise_prose",
        "run_turn_cycle_repair",
        "run_story_fact_promotion_to_canon"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stcharAuthorityCheck": {
      "type": "object",
      "required": [
        "stchar_id",
        "stent_id",
        "display_name",
        "required_because",
        "packet_present",
        "active_in_snapshot",
        "deterministic_verdict"
      ],
      "properties": {
        "stchar_id": { "type": "string", "pattern": "^STCHAR-(0|[1-9][0-9]*)$" },
        "stent_id": { "type": "string", "pattern": "^STENT-(0|[1-9][0-9]*)$" },
        "display_name": { "type": "string", "minLength": 1 },
        "required_because": { "type": "string", "minLength": 1 },
        "packet_present": { "type": "boolean" },
        "active_in_snapshot": { "type": "boolean" },
        "deterministic_verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "packet_present": { "const": false } }, "required": ["packet_present"] },
          "then": { "properties": { "deterministic_verdict": { "const": "FAIL" } } }
        },
        {
          "if": { "properties": { "active_in_snapshot": { "const": false } }, "required": ["active_in_snapshot"] },
          "then": { "properties": { "deterministic_verdict": { "const": "FAIL" } } }
        },
        {
          "if": { "properties": { "deterministic_verdict": { "const": "PASS" } }, "required": ["deterministic_verdict"] },
          "then": {
            "properties": {
              "packet_present": { "const": true },
              "active_in_snapshot": { "const": true }
            }
          }
        }
      ]
    },
    "profileFidelityVerdict": {
      "type": "string",
      "enum": ["pass", "minor_drift", "major_drift", "not_applicable"]
    },
    "profileFidelityCheck": {
      "type": "object",
      "required": [
        "stchar_id",
        "voice_fidelity",
        "appraisal_fidelity",
        "pressure_behavior_fidelity",
        "relationship_conduct_fidelity",
        "evidence",
        "repair_recommendation"
      ],
      "properties": {
        "stchar_id": { "type": "string", "pattern": "^STCHAR-(0|[1-9][0-9]*)$" },
        "voice_fidelity": { "$ref": "#/$defs/profileFidelityVerdict" },
        "appraisal_fidelity": { "$ref": "#/$defs/profileFidelityVerdict" },
        "pressure_behavior_fidelity": { "$ref": "#/$defs/profileFidelityVerdict" },
        "relationship_conduct_fidelity": { "$ref": "#/$defs/profileFidelityVerdict" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "repair_recommendation": {
          "type": "string",
          "enum": ["none", "revise_prose", "revise_page_plan", "regenerate_stchar", "run_turn_cycle_repair"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
