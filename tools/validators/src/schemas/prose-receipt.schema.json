{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/prose-receipt.schema.json",
  "type": "object",
  "required": [
    "page_id",
    "story_id",
    "plan_path",
    "prose_path",
    "plan_hash",
    "prose_hash",
    "state_hash_at_plan_time",
    "checked_at",
    "strict",
    "verdict",
    "checks",
    "notes",
    "repair_recommendation"
  ],
  "properties": {
    "page_id": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "plan_path": { "type": "string", "pattern": "^pages-prose-plans/PG-(0|[1-9][0-9]*)\\.md$" },
    "prose_path": { "type": "string", "pattern": "^pages-prose/PG-(0|[1-9][0-9]*)\\.md$" },
    "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prose_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_hash_at_plan_time": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "strict": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
    "checks": {
      "type": "object",
      "required": [
        "hash_integrity",
        "engine_jargon_leak",
        "forbidden_mystery_resolution",
        "required_event_rendered",
        "choice_consequence_visibility",
        "entity_status_consistency",
        "invented_structural_fact",
        "canon_claim_without_authority",
        "craft_critic"
      ],
      "properties": {
        "hash_integrity": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "engine_jargon_leak": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "forbidden_mystery_resolution": { "type": "string", "enum": ["PASS", "FAIL"] },
        "required_event_rendered": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "choice_consequence_visibility": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "entity_status_consistency": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "invented_structural_fact": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "canon_claim_without_authority": { "type": "string", "enum": ["PASS", "FAIL"] },
        "craft_critic": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "NOT_RUN"] }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repair_recommendation": {
      "type": "string",
      "enum": [
        "none",
        "revise_prose",
        "run_turn_cycle_repair",
        "run_story_fact_promotion_to_canon"
      ]
    }
  },
  "additionalProperties": false
}
