{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-consequence.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "status", "consequence_kind", "description", "resolves_when", "urgency"],
  "properties": {
    "record_kind": { "type": "string", "const": "consequence_record" },
    "id": { "type": "string", "pattern": "^CNSQ-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^CNSQ-(0|[1-9][0-9]*)$" },
    "status": { "type": "string", "enum": ["pending", "resolved", "escalated", "abandoned"] },
    "consequence_kind": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "urgency": { "type": "string", "enum": ["low", "medium", "high"] },
    "resolves_when": { "type": "string", "minLength": 1 },
    "derived_from": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(STENT|STSTAT|STINT|SF|BEL|SE|OBL|CNSQ|THR|CLK|STSEC|STQ|SREL|STLOC|STOBJ|DA|BR|PG|CHC|SLT|STPLAN|STEMO|CF|CH|M|INV|SEC)-[0-9]+$" }
    }
  },
  "additionalProperties": false
}
