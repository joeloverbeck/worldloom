{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-storylet.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "scope",
    "title",
    "move_family",
    "preconditions",
    "beats",
    "exit_options",
    "saliency",
    "mystery_policy",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SLT-[0-9]{4}$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]{3,4}$" },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^SLT-[0-9]{4}$"
    },
    "scope": {
      "type": "object",
      "required": ["visibility", "branch_id"],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["global_author_pool", "branch_prefix_scoped", "branch_scoped"]
        },
        "branch_id": {
          "type": ["string", "null"],
          "pattern": "^BR-[0-9]{4}$"
        }
      },
      "additionalProperties": false
    },
    "created_at_page": {
      "type": ["string", "null"],
      "pattern": "^PG-[0-9]{4}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "move_family": {
      "type": "string",
      "enum": [
        "orient",
        "world_pressure",
        "pursuit",
        "investigation",
        "disclosure",
        "negotiation",
        "bond_shift",
        "status_shift",
        "conflict",
        "evasion",
        "protection",
        "resource_exchange",
        "transformation",
        "ritual_protocol",
        "decision",
        "recovery"
      ]
    },
    "preconditions": {
      "type": "object",
      "required": ["hard"],
      "properties": {
        "hard": {
          "type": "array",
          "items": { "type": "object" }
        },
        "soft": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["beat_id", "function", "instruction"],
        "properties": {
          "beat_id": { "type": "string", "minLength": 1 },
          "function": {
            "type": "string",
            "enum": ["setup", "action", "pressure", "turn", "consequence", "exit"]
          },
          "instruction": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "create": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersede": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "close": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "exit_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_family", "surface_hint"],
        "properties": {
          "action_family": {
            "type": "string",
            "enum": [
              "move",
              "evade",
              "pursue",
              "perceive",
              "investigate",
              "communicate",
              "persuade",
              "negotiate",
              "bond",
              "oppose",
              "harm",
              "protect",
              "control",
              "transfer",
              "use",
              "make_change",
              "ritual_protocol",
              "recover",
              "wait",
              "decide"
            ]
          },
          "surface_hint": { "type": "string", "minLength": 1 },
          "likely_effects": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "saliency": {
      "type": "object",
      "required": ["urgency", "cooldown_pages"],
      "properties": {
        "urgency": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "cooldown_pages": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "mystery_policy": {
      "type": "object",
      "required": ["allowed_authority"],
      "properties": {
        "forbidden_resolutions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^M-[0-9]{4}$" }
        },
        "allowed_authority": {
          "type": "string",
          "enum": ["apparent", "branch_local_counterfactual", "canon_candidate", "none"]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["bootstrap_seed", "manual_authoring", "author_batch", "audit_repair", "runtime_jit"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
