{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/pressure-event-batch.schema.json",
  "title": "PressureEventBatchFrontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "world_slug", "generated_date", "parameters", "pressure_inventory_summary", "card_ids", "sidecars_emitted", "dropped_card_ids", "phase_4_drop_log_ids", "user_approved", "notes"],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
  },
  "properties": {
    "batch_id": { "type": "string", "pattern": "^BATCH-[0-9]+$" },
    "world_slug": { "$ref": "#/$defs/nonEmptyString" },
    "generated_date": { "$ref": "#/$defs/nonEmptyString" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_size", "novelty_range", "origin_type_focus", "taboo_areas", "current_date", "current_season"],
      "properties": {
        "batch_size": { "type": "integer", "minimum": 1 },
        "novelty_range": { "type": "string", "enum": ["conservative", "moderate", "bold"] },
        "origin_type_focus": {
          "type": "array",
          "items": { "type": "string", "enum": ["scarcity", "succession", "ecological_disruption", "taboo_breach", "technology_leakage", "migration", "faction_rivalry", "disease", "black_market", "theological_dispute", "anniversary", "relic_discovery", "trade_collapse", "climate"] }
        },
        "taboo_areas": { "$ref": "#/$defs/stringArray" },
        "current_date": { "type": "string" },
        "current_season": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "pressure_inventory_summary": { "$ref": "#/$defs/nonEmptyString" },
    "card_ids": { "type": "array", "items": { "type": "string", "pattern": "^EPE-[0-9]+$" } },
    "sidecars_emitted": { "type": "array", "items": { "type": "string", "pattern": "^EPE-[0-9]+$" } },
    "dropped_card_ids": { "type": "array", "items": { "type": "string", "pattern": "^EPE-[0-9]+$" } },
    "phase_4_drop_log_ids": { "type": "array", "items": { "type": "string", "pattern": "^EPE-[0-9]+$" } },
    "user_approved": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
