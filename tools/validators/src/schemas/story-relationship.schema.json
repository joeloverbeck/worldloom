{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-relationship.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "axis", "participants", "direction", "value", "valence", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^SREL-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^SREL-(0|[1-9][0-9]*)$" },
    "axis": {
      "type": "string",
      "enum": [
        "trust",
        "fear",
        "desire",
        "debt",
        "intimacy",
        "loyalty",
        "resentment",
        "power_imbalance",
        "attention",
        "familiarity",
        "approval",
        "respect",
        "obligation",
        "hostility"
      ]
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "pattern": "^STENT-[0-9]+$" }
    },
    "direction": {
      "type": "object",
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": { "type": "string", "enum": ["directed", "bidirectional"] },
        "from": { "type": ["string", "null"], "pattern": "^STENT-[0-9]+$" },
        "to": { "type": ["string", "null"], "pattern": "^STENT-[0-9]+$" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "directed" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "bidirectional" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "from": { "type": "null" },
              "to": { "type": "null" }
            }
          }
        }
      ]
    },
    "value": { "type": "string", "enum": ["none", "trace", "low", "medium", "high", "extreme"] },
    "valence": { "type": "string", "enum": ["symmetric", "asymmetric", "bidirectional", "adversarial"] },
    "description": { "type": "string", "minLength": 1 },
    "derived_from": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(STENT|STCHAR|STSTAT|STINT|SF|BEL|SE|OBL|CNSQ|THR|CLK|STSEC|STQ|SREL|STLOC|STOBJ|DA|BR|PG|CHC|SLT|STPLAN|STEMO|CF|CH|M|INV|SEC)-[0-9]+$" }
    }
  },
  "additionalProperties": false
}
