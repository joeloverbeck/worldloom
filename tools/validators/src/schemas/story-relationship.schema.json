{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-relationship.schema.json",
  "type": "object",
  "required": ["id", "story_id"],
  "properties": {
    "id": { "type": "string", "pattern": "^SREL-[0-9]+$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]+$" },
    "axis": {
      "enum": [
        "trust",
        "fear",
        "desire",
        "debt",
        "intimacy",
        "loyalty",
        "resentment",
        "power_imbalance",
        "attention",
        "familiarity",
        "approval",
        "respect",
        "obligation",
        "hostility"
      ]
    }
  },
  "additionalProperties": true
}
