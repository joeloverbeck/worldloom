{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-event.schema.json",
  "type": "object",
  "$defs": {
    "recordId": { "type": "string", "pattern": "^[A-Z]+-(?:0|[1-9][0-9]*)$" }
  },
  "required": [
    "id",
    "story_id",
    "created_at_page",
    "parent_page_id",
    "event_kind",
    "actor",
    "commitment",
    "outcome_route",
    "world_logic_rationale",
    "state_delta"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "story_event_record" },
    "id": { "type": "string", "pattern": "^SE-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "parent_page_id": { "type": ["string", "null"], "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "event_kind": {
      "type": "string",
      "enum": [
        "story_start",
        "turn_resolution",
        "system_repair",
        "audit_repair",
        "prose_attach",
        "promotion_closeout"
      ]
    },
    "actor": { "type": "string", "pattern": "^(STENT-[0-9]+|system|unknown)$" },
    "targets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(STENT|STLOC|STOBJ)-[0-9]+$" }
    },
    "commitment": {
      "type": "object",
      "required": ["selected_slt_id", "selection_source", "alias_bindings"],
      "properties": {
        "selected_slt_id": { "type": ["string", "null"], "pattern": "^SLT-(0|[1-9][0-9]*)$" },
        "selection_source": {
          "type": "string",
          "enum": [
            "emitted_choice",
            "author_pool",
            "runtime_jit",
            "npc_initiative",
            "offstage_initiative",
            "clock_fire",
            "world_pressure",
            "secret_reveal",
            "system_repair",
            "audit_repair",
            "none"
          ]
        },
        "alias_bindings": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(STENT|STSTAT|STINT|SF|BEL|OBL|CNSQ|THR|CLK|STSEC|STQ|STPLAN|STEMO|SREL|STLOC|STOBJ|DA)-[0-9]+$"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "selection_source": { "const": "none" } },
            "required": ["selection_source"]
          },
          "then": {
            "properties": { "selected_slt_id": { "type": "null" } }
          },
          "else": {
            "properties": { "selected_slt_id": { "type": "string", "pattern": "^SLT-(0|[1-9][0-9]*)$" } }
          }
        }
      ]
    },
    "turn_driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "initiator", "driver_records", "player_response_mode", "pov_visibility"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "player_action",
            "player_write_in",
            "npc_action",
            "offstage_action",
            "world_pressure",
            "clock_fire",
            "secret_reveal",
            "multi_actor_collision"
          ]
        },
        "initiator": { "type": "string", "pattern": "^(STENT-[0-9]+|player|world|system|unknown)$" },
        "driver_records": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(STPLAN|STEMO|CLK|THR|STSEC|STQ|OBL|CNSQ|SREL|STCHAR)-[0-9]+$"
          }
        },
        "player_response_mode": {
          "type": "string",
          "enum": ["initiates", "responds", "witnesses", "chooses_continuation", "none"]
        },
        "pov_visibility": {
          "type": "string",
          "enum": ["perceived_directly", "inferred_from_trace", "reported", "discovered_after", "withheld"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "player_action" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "const": "player" },
              "driver_records": { "type": "array", "maxItems": 0 },
              "player_response_mode": { "const": "initiates" },
              "pov_visibility": { "const": "perceived_directly" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "player_write_in" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "const": "player" },
              "driver_records": { "type": "array", "maxItems": 0 },
              "player_response_mode": { "const": "initiates" },
              "pov_visibility": { "const": "perceived_directly" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "npc_action" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "type": "string", "pattern": "^STENT-[0-9]+$" },
              "driver_records": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "string",
                  "pattern": "^(STPLAN|STEMO|CLK|THR|STCHAR)-[0-9]+$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "offstage_action" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "type": "string", "pattern": "^STENT-[0-9]+$" },
              "driver_records": { "type": "array", "minItems": 1 },
              "pov_visibility": { "enum": ["inferred_from_trace", "reported", "discovered_after", "withheld"] }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "clock_fire" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "enum": ["world", "system"] },
              "driver_records": {
                "type": "array",
                "minItems": 1,
                "contains": { "type": "string", "pattern": "^CLK-[0-9]+$" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "world_pressure" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "const": "world" },
              "driver_records": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "secret_reveal" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "driver_records": {
                "type": "array",
                "minItems": 1,
                "contains": { "type": "string", "pattern": "^STSEC-[0-9]+$" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "multi_actor_collision" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "initiator": { "const": "unknown" },
              "driver_records": { "type": "array", "minItems": 2 }
            }
          }
        }
      ]
    },
    "outcome_route": {
      "type": "string",
      "enum": ["accept", "accommodate", "attempt", "world_block", "promotion_hold", "terminal"]
    },
    "resolution": {
      "type": "object",
      "required": ["result", "player_visible_feedback"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["success", "partial_success", "failure", "impossible", "transformed", "held_for_promotion"]
        },
        "player_visible_feedback": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "world_logic_rationale": { "type": "string", "minLength": 1 },
    "record_introductions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["record_id", "class", "trigger", "evidence", "distinct_from"],
        "properties": {
          "record_id": { "$ref": "#/$defs/recordId" },
          "class": {
            "type": "string",
            "enum": ["CLK", "STSEC", "STQ", "THR", "STENT", "STCHAR", "SREL", "STPLAN", "STEMO"]
          },
          "trigger": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/recordId" }
          },
          "distinct_from": {
            "type": "array",
            "items": { "$ref": "#/$defs/recordId" }
          },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "class": { "const": "CLK" },
              "trigger": {
                "enum": [
                  "deadline_declared",
                  "pursuit_started",
                  "exposure_accumulation_started",
                  "faction_mobilized",
                  "environmental_degradation_started",
                  "mission_or_race_started",
                  "staged_danger_became_trackable"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STSEC" },
              "trigger": {
                "enum": [
                  "lie_made_hidden_truth_branch_relevant",
                  "hidden_truth_constrains_action",
                  "clue_carrier_enters_play",
                  "holder_access_changed",
                  "protected_mystery_story_secret_needed"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STQ" },
              "trigger": {
                "enum": [
                  "promise_made",
                  "explicit_question_raised",
                  "unexplained_evidence_introduced",
                  "affordance_setup_introduced",
                  "open_decision_created"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "THR" },
              "trigger": {
                "enum": [
                  "new_ongoing_causal_concern",
                  "investigation_line_opened",
                  "recovery_line_opened",
                  "negotiation_line_opened",
                  "mission_line_opened",
                  "social_fallout_line_opened"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STENT" },
              "trigger": {
                "enum": [
                  "actor_enters_branch",
                  "witness_needed",
                  "information_source_enters",
                  "pressure_driver_enters",
                  "counterparty_enters",
                  "choice_target_enters"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STCHAR" },
              "trigger": {
                "enum": [
                  "story_character_authority_distilled",
                  "story_character_authority_regenerated",
                  "story_local_character_authority_created"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "SREL" },
              "trigger": {
                "enum": [
                  "alliance_forms",
                  "rivalry_forms",
                  "debt_relation_forms",
                  "authority_relation_forms",
                  "trust_axis_becomes_relevant",
                  "fear_axis_becomes_relevant",
                  "desire_axis_becomes_relevant",
                  "intimacy_axis_becomes_relevant",
                  "loyalty_axis_becomes_relevant",
                  "resentment_axis_becomes_relevant",
                  "power_imbalance_axis_becomes_relevant",
                  "attention_axis_becomes_relevant",
                  "familiarity_axis_becomes_relevant",
                  "approval_axis_becomes_relevant",
                  "respect_axis_becomes_relevant",
                  "obligation_axis_becomes_relevant",
                  "hostility_axis_becomes_relevant"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STPLAN" },
              "trigger": {
                "enum": [
                  "tactical_approach_committed",
                  "resource_gained_enables_plan",
                  "blocker_requires_plan",
                  "pressure_forces_plan",
                  "opportunity_recognized",
                  "counterparty_plan_observed"
                ]
              }
            },
            "required": ["class", "trigger"]
          },
          {
            "properties": {
              "class": { "const": "STEMO" },
              "trigger": {
                "enum": [
                  "event_revealed_truth_to_actor",
                  "event_threatened_actor_or_charge",
                  "event_harmed_actor_or_charge",
                  "event_relieved_pressure_on_actor",
                  "event_violated_actor_principle_or_value",
                  "event_changed_relationship_with_other",
                  "accumulated_pressure_crossed_threshold"
                ]
              }
            },
            "required": ["class", "trigger"]
          }
        ]
      }
    },
    "state_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target_record"],
        "properties": {
          "relation": {
            "type": "string",
            "enum": ["advances", "tests", "blocks", "revises", "fulfills", "abandons", "ignores"]
          },
          "target_record": { "$ref": "#/$defs/recordId" }
        },
        "additionalProperties": false
      }
    },
    "non_propagation_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "group", "records"],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "no_witness",
              "witness_incapacitated",
              "evidence_concealed",
              "institution_suppresses_report",
              "event_leaves_no_accessible_trace"
            ]
          },
          "group": { "type": "string", "minLength": 1 },
          "records": {
            "type": "array",
            "items": { "$ref": "#/$defs/recordId" }
          }
        },
        "additionalProperties": false
      }
    },
    "state_delta": {
      "type": "object",
      "required": ["create", "supersede", "close"],
      "properties": {
        "create": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(STENT|STCHAR|STSTAT|STINT|SF|BEL|OBL|CNSQ|THR|CLK|STSEC|STQ|STPLAN|STEMO|SREL|STLOC|STOBJ|DA)-[0-9]+$" }
        },
        "supersede": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(STENT|STCHAR|STSTAT|STINT|SF|BEL|OBL|CNSQ|THR|CLK|STSEC|STQ|STPLAN|STEMO|SREL|STLOC|STOBJ|DA)-[0-9]+$" }
        },
        "close": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(STENT|STCHAR|STSTAT|STINT|SF|BEL|OBL|CNSQ|THR|CLK|STSEC|STQ|STPLAN|STEMO|SREL|STLOC|STOBJ|DA)-[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "promotion_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_record", "authority"],
        "properties": {
          "source_record": { "type": "string", "pattern": "^(SF|BEL|DA|STENT|STSTAT|SREL)-[0-9]+$" },
          "authority": { "type": "string", "enum": ["apparent", "branch_local_counterfactual", "canon_candidate"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "event_kind": { "const": "turn_resolution" } },
        "required": ["event_kind"]
      },
      "then": {
        "properties": { "turn_driver": {} },
        "required": ["turn_driver"]
      },
      "else": {
        "properties": { "turn_driver": false }
      }
    },
    {
      "if": {
        "properties": { "event_kind": { "enum": ["story_start", "system_repair", "audit_repair", "prose_attach", "promotion_closeout"] } },
        "required": ["event_kind"]
      },
      "then": {
        "properties": {
          "commitment": {
            "type": "object",
            "properties": {
              "selected_slt_id": { "type": "null" },
              "selection_source": { "const": "none" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "commitment": {
            "type": "object",
            "properties": {
              "selected_slt_id": { "type": "string", "pattern": "^SLT-(0|[1-9][0-9]*)$" },
              "selection_source": {
                "enum": [
                  "emitted_choice",
                  "author_pool",
                  "runtime_jit",
                  "npc_initiative",
                  "offstage_initiative",
                  "clock_fire",
                  "world_pressure",
                  "secret_reveal",
                  "system_repair",
                  "audit_repair"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "accept" } },
        "required": ["outcome_route"]
      },
      "then": {
        "properties": { "resolution": false }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "attempt" } },
        "required": ["outcome_route"]
      },
      "then": {
        "required": ["resolution"],
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "result": { "enum": ["success", "partial_success", "failure"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "accommodate" } },
        "required": ["outcome_route"]
      },
      "then": {
        "required": ["resolution"],
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "result": { "enum": ["partial_success", "transformed"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "world_block" } },
        "required": ["outcome_route"]
      },
      "then": {
        "required": ["resolution"],
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "result": { "enum": ["impossible", "failure"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "promotion_hold" } },
        "required": ["outcome_route"]
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "result": { "const": "held_for_promotion" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome_route": { "const": "terminal" } },
        "required": ["outcome_route"]
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "result": { "enum": ["success", "partial_success", "failure", "transformed"] }
            }
          }
        }
      }
    }
  ]
}
