{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-intention.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "holder", "intent", "urgency", "expires_when"],
  "properties": {
    "id": { "type": "string", "pattern": "^STINT-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^STINT-(0|[1-9][0-9]*)$" },
    "holder": { "type": "string", "pattern": "^STENT-[0-9]+$" },
    "intent": { "type": "string", "minLength": 1 },
    "urgency": { "type": "string", "enum": ["low", "medium", "high"] },
    "expires_when": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
