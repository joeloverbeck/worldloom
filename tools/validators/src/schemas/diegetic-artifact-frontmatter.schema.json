{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/diegetic-artifact-frontmatter.schema.json",
  "title": "DiegeticArtifactFrontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "slug", "title", "artifact_type", "author", "author_character_id", "date", "place", "audience", "communicative_purpose", "desired_relation_to_truth", "author_profile", "epistemic_horizon", "claim_map", "world_consistency", "source_basis"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^DA-[0-9]+$" },
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "statement_of_existence": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "author_character_id": {
      "anyOf": [
        { "type": "string", "pattern": "^CHAR-[0-9]+$" },
        { "type": "null" }
      ]
    },
    "date": { "type": "string" },
    "place": { "type": "string" },
    "audience": { "type": "string" },
    "scoped_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "relation"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "communicative_purpose": { "type": "string" },
    "desired_relation_to_truth": { "type": "string" },
    "world_relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corroborates": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } },
        "contests": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } },
        "conceals": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } },
        "mythologizes": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } },
        "ritualizes": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } }
      }
    },
    "canon_facts_accessible": { "anyOf": [{ "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } }, { "type": "null" }] },
    "taboo_censorship_conditions": { "anyOf": [{ "type": "array" }, { "type": "string" }, { "type": "null" }] },
    "desired_length": { "anyOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
    "emotional_tone": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "rhetorical_style": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "ornament_level": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "mystery_seeding_intent": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
    "contradiction_target": { "anyOf": [{ "type": "string", "pattern": "^DA-[0-9]+$" }, { "type": "null" }] },
    "genre_conventions": { "type": "object" },
    "author_profile": { "type": "object" },
    "epistemic_horizon": { "type": "object" },
    "claim_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "canon_status", "narrator_belief", "source", "contradiction_risk", "mode"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "canon_status": {
            "type": "string",
            "enum": [
              "canonically_true",
              "canonically_false",
              "partially_true",
              "contested",
              "mystery_adjacent",
              "prohibited_for_this_artifact"
            ]
          },
          "narrator_belief": {
            "type": "string",
            "enum": ["true", "false", "uncertain", "performed_belief"]
          },
          "source": {
            "type": "string",
            "enum": [
              "witnessed",
              "learned_from_authority",
              "inherited_tradition",
              "common_rumor",
              "contested_scholarship",
              "impossible_for_narrator_to_verify"
            ]
          },
          "contradiction_risk": {
            "type": "string",
            "enum": ["none", "soft", "hard"]
          },
          "mode": {
            "type": "string",
            "enum": ["direct", "implied", "symbolic"]
          },
          "adaptive_behavior_preserved_under_wrong_ontology": { "type": "boolean" },
          "cf_id": {
            "anyOf": [
              { "type": "string", "pattern": "^CF-[0-9]+$" },
              { "type": "null" }
            ]
          },
          "mr_id": {
            "anyOf": [
              { "type": "string", "pattern": "^M-[0-9]+$" },
              { "type": "null" }
            ]
          },
          "repair_trace": {
            "anyOf": [
              { "type": "object" },
              { "type": "null" }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "canon_status": { "const": "canonically_true" }
              },
              "required": ["canon_status"]
            },
            "then": {
              "properties": {
                "cf_id": { "type": "string", "pattern": "^CF-[0-9]+$" }
              },
              "required": ["cf_id"]
            }
          },
          {
            "if": {
              "properties": {
                "canon_status": { "const": "mystery_adjacent" }
              },
              "required": ["canon_status"]
            },
            "then": {
              "properties": {
                "mr_id": { "type": "string", "pattern": "^M-[0-9]+$" }
              },
              "required": ["mr_id"]
            }
          }
        ]
      }
    },
    "canon_links": { "type": "array", "items": { "type": "string", "pattern": "^CF-[0-9]+$" } },
    "cannot_know": { "type": "array", "items": { "type": "string" } },
    "world_consistency": { "type": "object" },
    "source_basis": { "type": "object" },
    "notes": { "type": "string" }
  }
}
