{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-character-authority.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "story_slug",
    "world_slug",
    "source_kind",
    "source_char_id",
    "source_char_sections_used",
    "generated_at_page",
    "created_by_skill",
    "supersedes",
    "status",
    "bound_stent_ids",
    "profile_revision",
    "body_schema_version"
  ],
  "properties": {
    "record_kind": { "type": "string", "const": "story_character_authority_record" },
    "id": { "type": "string", "pattern": "^STCHAR-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "story_slug": { "type": "string", "minLength": 1 },
    "world_slug": { "type": "string", "minLength": 1 },
    "source_kind": { "type": "string", "enum": ["world_char", "story_local", "hybrid", "regenerated"] },
    "source_char_id": { "type": ["string", "null"], "pattern": "^CHAR-[0-9]+$" },
    "source_char_sections_used": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_operational_fact_map": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["source_field", "disposition"],
        "properties": {
          "source_field": {
            "type": "string",
            "enum": [
              "world_produced_wound",
              "active_appetite",
              "self_mythology",
              "irreconcilable_contradiction",
              "pressure_behavior",
              "relational_charge",
              "moral_psychological_edge",
              "signature_scene_behaviors",
              "voice_under_pressure",
              "cannot_be_swapped_out_because"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "copied",
              "transformed",
              "compressed",
              "omitted_with_rationale",
              "story_irrelevant"
            ]
          },
          "target_section": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "copied",
                    "transformed",
                    "compressed"
                  ]
                }
              },
              "required": ["disposition"]
            },
            "then": {
              "required": ["target_section"],
              "properties": {
                "target_section": {
                  "type": "string",
                  "enum": [
                    "Story-Facing Identity",
                    "Stable Persona Core",
                    "Emotional Appraisal Map",
                    "Pressure Behavior",
                    "Voice Bible / Dialogue Authority",
                    "Page-Plan Voice Block",
                    "Perception and Embodiment",
                    "Agency and Planning Tendencies",
                    "Relationship-Specific Behavior",
                    "Story-State Derivation Guide",
                    "Prose Rendering Constraints"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "regeneration_reason_class": {
      "type": ["string", "null"],
      "enum": [
        "source_world_char_material_change",
        "durable_branch_transformation",
        "profile_fidelity_failure",
        "story_local_character_promotion",
        "stable_source_material_omission_repair",
        null
      ]
    },
    "story_local_inputs_used": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(STENT|SF|BEL|DA|SE|CHC|STPLAN|STEMO|SREL|STINT|STSTAT|STLOC|STOBJ|THR|OBL|CNSQ|CLK|STSEC|STQ|PG|BR|SLT)-(0|[1-9][0-9]*)$" }
    },
    "generated_at_page": {
      "oneOf": [
        { "type": "string", "const": "story_bootstrap" },
        { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
        { "type": "null" }
      ]
    },
    "created_by_skill": { "type": "string", "minLength": 1 },
    "supersedes": { "type": ["string", "null"], "pattern": "^STCHAR-(0|[1-9][0-9]*)$" },
    "superseded_by": { "type": ["string", "null"], "pattern": "^STCHAR-(0|[1-9][0-9]*)$" },
    "status": { "type": "string", "enum": ["active", "superseded", "retired"] },
    "bound_stent_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^STENT-(0|[1-9][0-9]*)$" }
    },
    "profile_revision": { "type": "integer", "minimum": 1 },
    "body_schema_version": { "type": "string", "const": "stchar.v1" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "source_kind": { "const": "world_char" } },
        "required": ["source_kind"]
      },
      "then": {
        "required": ["source_char_id"],
        "properties": {
          "source_char_id": { "type": "string", "pattern": "^CHAR-[0-9]+$" }
        }
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "story_local" } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "source_char_id": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": { "source_kind": { "const": "regenerated" } },
            "required": ["source_kind"]
          },
          {
            "properties": { "supersedes": { "type": "string" } },
            "required": ["supersedes"]
          }
        ]
      },
      "then": {
        "required": ["regeneration_reason_class"],
        "properties": {
          "regeneration_reason_class": {
            "type": "string",
            "enum": [
              "source_world_char_material_change",
              "durable_branch_transformation",
              "profile_fidelity_failure",
              "story_local_character_promotion",
              "stable_source_material_omission_repair"
            ]
          }
        }
      }
    }
  ]
}
