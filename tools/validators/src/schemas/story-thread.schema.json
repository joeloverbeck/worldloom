{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-thread.schema.json",
  "type": "object",
  "required": ["id", "story_id"],
  "properties": {
    "id": { "type": "string", "pattern": "^THR-[0-9]+$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]+$" }
  },
  "additionalProperties": true
}
