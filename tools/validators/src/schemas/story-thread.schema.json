{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-thread.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "status", "title", "summary", "urgency"],
  "properties": {
    "record_kind": { "type": "string", "const": "thread_record" },
    "id": { "type": "string", "pattern": "^THR-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "supersedes": { "type": ["string", "null"], "pattern": "^THR-(0|[1-9][0-9]*)$" },
    "status": { "type": "string", "enum": ["active", "resolved", "escalated", "abandoned"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "urgency": { "type": "string", "enum": ["low", "medium", "high"] },
    "derived_from": {
      "type": "array",
      "items": { "type": "string", "pattern": "^((STENT|STCHAR|STSTAT|STINT|SF|BEL|SE|OBL|CNSQ|THR|CLK|STSEC|STQ|SREL|STLOC|STOBJ|DA|BR|PG|CHC|SLT|STPLAN|STEMO|CF|CH|M|OQ|ENT|ONT|CAU|DIS|SOC|AES)-[0-9]+|SEC-(GEO|INS|MTS|ECR|PAS|TML|ELF)-[0-9]+)$" }
    }
  },
  "additionalProperties": false
}
