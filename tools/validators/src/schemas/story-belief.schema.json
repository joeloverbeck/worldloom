{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-belief.schema.json",
  "type": "object",
  "required": [
    "id",
    "story_id",
    "created_at_page",
    "holder",
    "claim",
    "belief_mode",
    "truth_relation",
    "confidence",
    "visibility",
    "basis",
    "consequences"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^BEL-[0-9]+$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]+$" },
    "created_at_page": { "type": "string", "pattern": "^PG-[0-9]+$" },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^BEL-[0-9]+$"
    },
    "holder": {
      "type": "string",
      "pattern": "^(STENT-[0-9]+|group:[A-Za-z0-9 _:-]+|public|narrator)$"
    },
    "claim": { "type": "string", "minLength": 1 },
    "belief_mode": {
      "enum": ["knows", "believes", "suspects", "doubts", "denies", "reports", "claims", "deceives", "misremembers", "interprets"]
    },
    "truth_relation": {
      "enum": ["true", "false", "partly_true", "unknown", "contested", "branch_counterfactual", "future_contingent"]
    },
    "confidence": {
      "enum": ["certain", "high", "medium", "low", "uncommitted"]
    },
    "visibility": {
      "enum": ["private", "shared", "factional", "public", "rumored", "concealed", "suppressed"]
    },
    "basis": {
      "type": "object",
      "required": ["source_event", "access_route"],
      "properties": {
        "source_event": { "type": "string", "pattern": "^SE-[0-9]+$" },
        "access_route": {
          "enum": [
            "direct_observation",
            "testimony",
            "document",
            "object_trace",
            "location_trace",
            "inference",
            "surveillance",
            "institutional_channel",
            "magic_tech",
            "rumor",
            "authorial_initialization"
          ]
        },
        "access_records": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(STENT|STLOC|STOBJ|DA|BEL|SF|SE)-[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "consequences": {
      "type": "object",
      "required": ["opens", "constrains_choices"],
      "properties": {
        "opens": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(OBL|THR|CNSQ)-[0-9]+$" }
        },
        "constrains_choices": {
          "type": "array",
          "items": { "type": "string", "pattern": "^CHC-[0-9]+$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
