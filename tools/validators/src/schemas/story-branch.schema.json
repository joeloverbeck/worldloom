{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-branch.schema.json",
  "type": "object",
  "required": ["id", "story_id", "created_at_page", "label", "parent_branch_id", "forked_at_page_id", "root_page_id"],
  "properties": {
    "record_kind": { "type": "string", "const": "branch_record" },
    "id": { "type": "string", "pattern": "^BR-(0|[1-9][0-9]*)$" },
    "story_id": { "type": "string", "pattern": "^STORY-(0|[1-9][0-9]*)$" },
    "created_at_page": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parent_branch_id": { "type": ["string", "null"], "pattern": "^BR-(0|[1-9][0-9]*)$" },
    "forked_at_page_id": { "type": ["string", "null"], "pattern": "^PG-(0|[1-9][0-9]*)$" },
    "root_page_id": { "type": "string", "pattern": "^PG-(0|[1-9][0-9]*)$" }
  },
  "additionalProperties": false
}
