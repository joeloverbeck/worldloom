{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloom.local/schemas/story-choice.schema.json",
  "type": "object",
  "required": ["id", "story_id"],
  "properties": {
    "id": { "type": "string", "pattern": "^CHC-[0-9]+$" },
    "story_id": { "type": "string", "pattern": "^STORY-[0-9]+$" },
    "surface_label": { "type": "string", "minLength": 1 },
    "player_visible_intent": { "type": "string", "minLength": 1 },
    "target_or_action_family": {
      "type": "string",
      "enum": [
        "move",
        "evade",
        "pursue",
        "perceive",
        "investigate",
        "communicate",
        "persuade",
        "negotiate",
        "bond",
        "oppose",
        "harm",
        "protect",
        "control",
        "transfer",
        "use",
        "make_change",
        "ritual_protocol",
        "recover",
        "wait",
        "decide",
        "attempt"
      ]
    },
    "likely_state_pressure": { "type": "string", "minLength": 1 },
    "associated_commitment_block": {
      "type": ["string", "null"],
      "pattern": "^SLT-[0-9]+$"
    },
    "success_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
