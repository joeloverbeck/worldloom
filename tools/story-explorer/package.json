{
  "name": "@worldloom/story-explorer",
  "version": "0.1.0",
  "description": "Local read-only backend for browsing Worldloom story bundles",
  "private": true,
  "type": "module",
  "bin": {
    "story-explorer": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@worldloom/world-index": "file:../world-index",
    "better-sqlite3": "12.10.0",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
